# Servidor de back-end
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://elociv:elociv@localhost:5432/elociv_dev

# JWT
JWT_SECRET=troque-por-um-segredo-forte-antes-do-deploy
JWT_EXPIRES_IN=7d

# OTP (mock no MVP: código exibido apenas no log do servidor)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Uploads de documentos comprobatórios (pasta local — MVP)
UPLOADS_DIR=./uploads

# Integração Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contrato elociv-registry
ELOCIV_CONTRACT_ID=

# Conta custodiante (emissor técnico único)
ELOCIV_ISSUER_PUBLIC_KEY=
ELOCIV_ISSUER_SECRET_KEY=
