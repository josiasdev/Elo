{
  "name": "elociv-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Node.js do EloCiv — Civic Tech de credenciais verificáveis para adolescentes",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.3",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.0",
    "@prisma/client": "^6.8.2",
    "@stellar/stellar-sdk": "^13.3.0",
    "fastify": "^5.2.2",
    "nodemailer": "^6.10.1",
    "pino": "^9.6.0",
    "zod": "^3.25.71"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.28.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  }
}
